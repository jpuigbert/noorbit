{
  "segments": [
    { "id": "n1", "in": 0.40, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "Cada disseny comença amb una carpeta buida." },
    { "id": "n2", "in": 5.00, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "Vint finestres obertes i cap línia de codi." },
    { "id": "n3", "in": 10.60, "voice": "Montse", "rate": 160, "pbas": 64,
      "text": "NoOrbit!" },
    { "id": "n4", "in": 13.70, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "Li pots dir exactament què vols fer." },
    { "id": "n5", "in": 17.00, "voice": "Montse", "rate": 160, "pbas": 64,
      "text": "I jo escric el codi. Fitxer a fitxer!" },
    { "id": "n6", "in": 20.80, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "I quan la memòria s'acaba?" },
    { "id": "n7", "in": 23.40, "voice": "Montse", "rate": 160, "pbas": 64,
      "text": "Condenso el context i continuo! De debò!" },
    { "id": "n8", "in": 27.90, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "I el codi surt del meu ordinador?" },
    { "id": "n9", "in": 31.10, "voice": "Montse", "rate": 160, "pbas": 64,
      "text": "Amb un model local, no! Res surt de la teua màquina." },
    { "id": "n10", "in": 36.10, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "De la idea al tema publicat, tot en una sola finestra." },
    { "id": "n11", "in": 43.60, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "Fes-lo, revisa'l i puja'l." },
    { "id": "n12", "in": 46.30, "voice": "Montse", "rate": 160, "pbas": 64,
      "text": "Al marketplace!" },
    { "id": "n13", "in": 48.10, "voice": "Montse", "rate": 150, "pbas": 50,
      "text": "Trobaràs el teu tema a themes dot thepuigberts dot com." }
